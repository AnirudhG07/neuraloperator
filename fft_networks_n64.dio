    <diagram id="converted_h1" name="PE_Ax3_pass">
        <mxGraphModel dx="595" dy="584" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="h1_html_0" value="&lt;b&gt;N=64, 6 stages → 3 identical PE-A passes.&lt;/b&gt;&lt;br&gt;Bit-reverse input once. Same shuffle &lt;code&gt;(i×2) mod 64&lt;/code&gt; between every pass. Same PE-A wiring every pass — only twiddle ROM base address changes." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
                    <mxGeometry x="60" y="120" width="760" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="h1_html_2" value="&lt;b&gt;Identical across all three PE-A passes:&lt;/b&gt; butterfly wiring, SRAM access pattern, shuffle formula &lt;code&gt;(i×2) mod 64&lt;/code&gt;, PE slot assignments.&lt;br&gt;&lt;b&gt;Changes:&lt;/b&gt; one register — &lt;code&gt;W_base&lt;/code&gt; — which tells the twiddle ROM where to start reading. Pass 1: base=0. Pass 2: base=16. Pass 3: base=48." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
                    <mxGeometry x="60" y="700" width="760" height="70" as="geometry"/>
                </mxCell>
