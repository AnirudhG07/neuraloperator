    <diagram id="0oFbyRFpNyySvjL72A4z" name="FNO">
        <mxGraphModel dx="595" dy="584" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <UserObject label="Observations:&#xa;1. If we do FFT and iFFT with Cooley-tukey, we donot need to do bit reversal AT ALL. This is because &#xa;&#xa;Bit revesed output from FFT -&gt; Permuted R -&gt; bit reversed output from iFFT&#xa;&#xa;This gives the exact same ordering. So per Fourier Layer we donot need to do bit reversal at all. hence Skip matrix W can also remain unchanged. Only thing changes is R!" link="https://arxiv.org/abs/2108.08481." id="l4_PFeZLqHhpXUek-JN7-2">
                    <mxCell style="text;whiteSpace=wrap;fontStyle=1" vertex="1" parent="1">
                        <mxGeometry x="40" y="41" width="740" height="99" as="geometry"/>
                    </mxCell>
                </UserObject>
            </root>
        </mxGraphModel>
    </diagram>
