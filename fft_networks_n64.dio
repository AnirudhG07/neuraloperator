                </mxCell>
                <mxCell id="2" value="&lt;b&gt;For Inverse FFT, We need to simply take conjugate of the twiddle Factor. W becomes W*. Rest is the same.&amp;nbsp;&lt;br&gt;Also we would need to do `1/N` at the end of the output to each element.&amp;nbsp;&lt;br&gt;We can do bit reversal at the end, instead of the beginning.&lt;br&gt;&lt;/b&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
                    <mxGeometry x="70" y="790" width="760" height="60" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
    <diagram id="converted_h2" name="PE-Ax2_PE-Bx1_pass">
        <mxGraphModel dx="704" dy="584" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="2400" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="h2_html_0" value="N=64, 6 stages, two 4-PE networks, 3 passes. Bit-reverse the input once. Then every inter-pass shuffle is identical stride-2. Output comes out in natural order — no reorder needed." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
                    <mxGeometry x="60" y="160" width="760" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="h2_html_2" value="&lt;b&gt;Why bit-rev first?&lt;/b&gt;&lt;br&gt;Two valid choices — bit-reverse input vs bit-reverse output. Bit-rev input wins for hardware." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
                    <mxGeometry x="60" y="610" width="760" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="h2_html_4" value="Pass 0 (pre): Bit-reverse x[0..63] once.&lt;br&gt;Pass 1: PE-A, stages 1+2, twiddles W₂⁰; W₄⁰ W₄¹.&lt;br&gt;Shuffle: addr = (i×2) mod 64.&lt;br&gt;Pass 2: PE-B, stages 3+4, twiddles W₈⁰…W₈³; W₁₆⁰…W₁₆⁷.&lt;br&gt;Shuffle: addr = (i×2) mod 64 (same formula).&lt;br&gt;Pass 3: PE-A (reused), stages 5+6, twiddles W₃₂⁰…W₃₂¹⁵; W₆₄⁰…W₆₄³¹.&lt;br&gt;Output: X[0..63] in natural order.&lt;br&gt;&lt;b&gt;Only change between passes:&lt;/b&gt; twiddle Buffer base address. Wiring, shuffle formula(?)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
                    <mxGeometry x="60" y="1030" width="760" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="h2_html_6" value="&lt;b&gt;Tab 3 — Reuse proof.&lt;/b&gt;&lt;br&gt;Why PE-A can truly be the same physical circuit in pass 1 and pass 3." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
                    <mxGeometry x="60" y="1910" width="760" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="h2_bitrev" value="&lt;b&gt;Bit-rev&lt;/b&gt;&lt;br&gt;input once" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="80" y="300" width="70" height="260" as="geometry"/>
                </mxCell>
                <mxCell id="h2_pea1" value="&lt;b&gt;PE-A&lt;/b&gt;&lt;br&gt;stg 1+2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="170" y="300" width="90" height="260" as="geometry"/>
                </mxCell>
                <mxCell id="h2_shuf1" value="&lt;b&gt;Shuffle&lt;/b&gt;&lt;br&gt;(i*2) mod 64" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="270" y="300" width="70" height="260" as="geometry"/>
                </mxCell>
                <mxCell id="h2_peb" value="&lt;b&gt;PE-B&lt;/b&gt;&lt;br&gt;stg 3+4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="360" y="300" width="90" height="260" as="geometry"/>
                </mxCell>
                <mxCell id="H7CmKXmGoTk6itzzFgrt-164" style="edgeStyle=none;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="h2_shuf2" target="H7CmKXmGoTk6itzzFgrt-10">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="560" y="600" as="targetPoint"/>
                        <Array as="points">
                            <mxPoint x="505" y="600"/>
                            <mxPoint x="605" y="600"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="h2_shuf2" value="&lt;b&gt;Shuffle&lt;/b&gt;&lt;br&gt;(i*2) mod 64" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="470" y="300" width="70" height="260" as="geometry"/>
                </mxCell>
                <mxCell id="h2_out" value="&lt;b&gt;Output&lt;/b&gt;&lt;br&gt;natural order" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" parent="1" vertex="1">
                    <mxGeometry x="950" y="320" width="50" height="220" as="geometry"/>
                </mxCell>
                <mxCell id="h2_e1" style="edgeStyle=straight;orthogonal=0;curved=0;endArrow=block;endFill=1;strokeColor=#333333;strokeWidth=1.1;" parent="1" source="h2_bitrev" target="h2_pea1" edge="1">
